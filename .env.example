# Copy to .env and adjust. Every variable is optional; defaults are shown.

# --- Service ---
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
DOCS_ENABLED=true                  # Swagger at /docs

# --- Database ---
# Postgres (docker compose sets this for you). SQLite works for quick local runs:
# DATABASE_URL=sqlite:///./address_intel.db
DATABASE_URL=postgresql://address:address@localhost:5432/address_intel
AUTO_SEED=true                     # load India Post + curated data on first start if the DB is empty

# --- Auth & limits ---
API_KEYS=local-dev-key             # comma-separated. Empty + development = auth off. Production requires keys.
RATE_LIMIT_PER_MINUTE=120          # per API key, in-process token bucket
RATE_LIMIT_BURST=30
MAX_BATCH_SIZE=500

# --- Resolution thresholds ---
CONFIDENCE_HIGH=0.85               # >= this at locality level -> "resolved" (safe to auto-normalise)
CONFIDENCE_MEDIUM=0.60
CONFIDENCE_LOW=0.35                # below -> "unresolved"
AMBIGUITY_MARGIN=0.06              # best two candidates in different places closer than this -> "ambiguous"

# --- Privacy ---
STORE_RESOLUTION_METADATA=true     # status/confidence/latency + input fingerprint (no address text)
STORE_ADDRESS_TEXT=false           # store raw input & resolved address in resolution_logs
DATA_RETENTION_DAYS=30             # purge logs and feedback text after N days (0 = never)
LOG_ADDRESS_TEXT=false             # NEVER enable in production

# --- Optional LLM assist (off by default). Addresses are sent to the provider only if
# LLM_SEND_ADDRESS_DATA=true. Providers: none | openai | anthropic | google | openai_compatible | mock
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=                      # for openai_compatible (vLLM, Ollama /v1, Groq, Together ...)
LLM_MODE=fallback                  # fallback = only when no locality was found; always; off
LLM_SEND_ADDRESS_DATA=false

# --- Optional external geocoders (off by default) for finer coordinates ---
GEO_PROVIDERS=local                # e.g. local,photon,nominatim,geoapify
GEO_SEND_ADDRESS_DATA=false
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=india-address-intelligence/0.1 (you@example.com)
PHOTON_URL=https://photon.komoot.io
GEOAPIFY_API_KEY=

# --- Optional speech-to-text for /v1/address/resolve/audio ---
STT_PROVIDER=none                  # none | deepgram | openai_whisper | sarvam | mock
STT_API_KEY=
STT_MODEL=

# --- Optional: import an OpenStreetMap extract at container start ---
# OSM_IMPORT_PATH=/data/southern-zone-latest.osm.pbf
